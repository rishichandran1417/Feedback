# Apex College Feedback & Grievance Management System - Environment Variables

# Frontend Environment Variables (Vite)
# Replace with your Supabase Project URL and Publishable/Anon Key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-fallback

# Optional: Application Portal Public URL
VITE_PORTAL_URL=http://localhost:5173

# Server-Side / Supabase Edge Function Secrets (NEVER EXPOSE IN FRONTEND CODE)
# Set these inside Supabase Dashboard -> Project Settings -> Edge Functions -> Secrets
# Or via Supabase CLI: `supabase secrets set RESEND_API_KEY=re_...`
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_SENDER_NAME="Apex College Grievance Cell"
RESEND_SENDER_EMAIL=notifications@college.edu
COLLEGE_NAME="Apex Institute of Technology"
PORTAL_URL=https://feedback.college.edu
