# College of Engineering Trivandrum (CET) Feedback & Grievance Management System - Environment Variables

# Frontend Environment Variables (Vite)
# Replace with your Supabase Project URL and Publishable/Anon Key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-fallback

# Optional: Application Portal Public URL
VITE_PORTAL_URL=http://localhost:5174

# Google OAuth & Authentication Configuration
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
AUTH_SECRET=your_auth_secret_here_for_session_encryption_or_nextauth
ALLOWED_EMAIL_DOMAIN=@cet.ac.in
VITE_ALLOWED_EMAIL_DOMAIN=@cet.ac.in
VITE_COLLEGE_EMAIL_DOMAIN=cet.ac.in

# Server-Side / Supabase Edge Function Secrets (NEVER EXPOSE IN FRONTEND CODE)
# Set these inside Supabase Dashboard -> Project Settings -> Edge Functions -> Secrets
# Or via Supabase CLI: `supabase secrets set RESEND_API_KEY=re_...`
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_SENDER_NAME="CET Grievance Cell"
RESEND_SENDER_EMAIL=notifications@cet.ac.in
COLLEGE_NAME="College of Engineering Trivandrum"
PORTAL_URL=https://feedback.rishichandran17.workers.dev
